# Copy this file to keystore.properties (it is ignored by git) and fill it in.
# storeFile is relative to the project root; an absolute path also works.
# ..\..\keystore\create_sentrycam_keystore.bat creates the key where this expects it.
storeFile=../../keystore/sentrycam-release.jks
storePassword=CHANGE_ME
keyAlias=sentrycam
keyPassword=CHANGE_ME
