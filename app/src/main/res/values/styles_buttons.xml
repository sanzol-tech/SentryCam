<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TimerPlus buttons (styles_buttons.xml), copied verbatim for the subset SentryCam uses. -->
    <style name="ButtonBase">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingStart">@dimen/space_m</item>
        <item name="android:paddingEnd">@dimen/space_m</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:drawablePadding">@dimen/space_s</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ButtonPrimary" parent="ButtonBase">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_primary_content</item>
        <item name="android:drawableTint">@color/button_primary_content</item>
    </style>

    <style name="ButtonSecondary" parent="ButtonBase">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/button_secondary_content</item>
        <item name="android:drawableTint">@color/button_secondary_content</item>
    </style>

    <style name="SegmentChip" parent="ButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:textColor">@color/preset_content</item>
    </style>
</resources>
