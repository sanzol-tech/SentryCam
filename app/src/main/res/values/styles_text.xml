<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        TimerPlus type scale as styles (styles_text.xml), copied verbatim for the subset
        SentryCam uses: size, color and case only. A text view takes one of these (or a style
        built on one); it never sets its own size or color. Numbers that tick add
        android:fontFamily="monospace".
    -->
    <style name="TextLabel">
        <item name="android:textSize">@dimen/text_meta</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/ink_secondary</item>
    </style>

    <style name="TextMeta">
        <item name="android:textSize">@dimen/text_meta</item>
        <item name="android:textColor">@color/ink_secondary</item>
    </style>

    <!-- Meta text over the live view, on the preview scrim. -->
    <style name="TextPreviewLabel" parent="TextMeta">
        <item name="android:textColor">@color/on_preview_scrim</item>
    </style>

    <style name="TextBody">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextBodySecondary" parent="TextBody">
        <item name="android:textColor">@color/ink_secondary</item>
    </style>

    <style name="TextTitle">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextHeading">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="ScreenTitle" parent="TextHeading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ScreenSubtitle" parent="TextBodySecondary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="FieldLabel" parent="TextLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/space_l</item>
    </style>

    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/edittext_underline</item>
        <item name="android:paddingTop">@dimen/field_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/field_padding_vertical</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_hint</item>
    </style>
</resources>
