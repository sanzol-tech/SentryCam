<?xml version="1.0" encoding="utf-8"?>
<!-- One fact on the About screen: what it is at the start, its value at the end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/about_row_min_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:baselineAligned="false">

    <TextView
        android:id="@+id/about_row_label"
        style="@style/TextBodySecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/about_row_value"
        style="@style/TextBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_m"
        android:gravity="end"
        android:textIsSelectable="true" />
</LinearLayout>
