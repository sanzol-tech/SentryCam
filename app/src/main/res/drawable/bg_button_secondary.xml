<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <stroke android:width="@dimen/stroke_thin" android:color="@color/line" />
                <corners android:radius="@dimen/radius_button" />
            </shape>
            </item>
            <item>
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <stroke android:width="@dimen/stroke_thin" android:color="@color/ink_secondary" />
                <corners android:radius="@dimen/radius_button" />
            </shape>
            </item>
        </selector>
    </item>
</ripple>
